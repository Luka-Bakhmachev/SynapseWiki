{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the SynapseWiki desktop window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:menu:default",
    "dialog:allow-open",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-write-text-file"
  ]
}
